spring:
  application:
    name: Report-Service
  config:
    import: optional:configserver:http://localhost:2222/
  boot:
    admin:
      client:
        url: http://localhost:1111/
  datasource:
    url: jdbc:mysql://localhost:3306/bluepal_ecomm?allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: root
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

management:
  endpoints:
    web:
      exposure:
        include: '*'

server:
  port: 8086

# Application Messages
reports-service:
  messages:
    orderFetch: All Orders fetched successfully
    orderFetchErr: Failed to fetch all Orders
